---
import Base from '../layouts/Base.astro';
import ObservableEmbed from '../components/ObservableEmbed.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles } from '../lib/articles';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;

// 2 lignes de 3 cadres visibles, les autres repliés
const articles = await getArticles();
const visibles = articles.slice(0, 6);
const autres = articles.slice(6);
---

<Base
  title="Accueil"
  description="Coach numérique, médiation sensible et tangible, cheminement à travers les champs de la technè."
>
  
  <div class="embeds">
    <ObservableEmbed
      src="https://observablehq.com/embed/@pixflowave/graph_neguentropie?cells=chartR"
      title="Graphe réticulé des bifurcations noétiques"
      ratio="3 / 2"
      invert
    >
      Graphe réticulé ·
      <a href="https://observablehq.com/@pixflowave/graph_neguentropie">Néguentropie by Pixflowave</a>
    </ObservableEmbed>

    <ObservableEmbed
      src="https://observablehq.com/embed/@pixflowave/airocean-attracteur-de-lorentz@710?cells=dual"
      title="Projection Aireocean | Attracteur étrange de Lorentz"
      ratio="3 / 2"
      invert
    >
      Projection Aireocean | Attracteur étrange de Lorentz
      <a href="https://observablehq.com/@pixflowave/airocean-attracteur-de-lorentz@710">Néguentropie by Pixflowave</a>
    </ObservableEmbed>
  </div>

  <h1>Erwan Bozec</h1>

  <p class="lede">
  De formation initiale en Mécanique et Automatismes Industriels, il s’évade d’abord par le truchement de l’<a href={withBase('/image/')}>image</a>. Il devient <a href={withBase('/coach-numerique/')}>Coach Numérique</a> puis, en collaboration avec le <a href="https://mediation.artefacts.coop/">Pôle Médiation</a> d’<a href="https://www.artefacts.coop/">Artéfacts</a>, s’investit dans le design de <a href={withBase('/mediation-sensible-tangible/')}>médiation sensible &amp; tangible</a>. Il porte une attention toute particulière aux recherches menées par le collectif <a href="https://organoesis.org">Organoesis</a> ainsi qu’aux travaux du séminaire « <a href="https://p-node.org/broadcasts/machines-a-coexister">Technologies de l’esprit, machines à coexister</a> ». Son travail est un cheminement à travers les champs de la <a href="https://fr.wikipedia.org/wiki/Techn%C3%A8">technè</a>.
  </p>

  <h2>Articles</h2>
  <ul class="cards">
    {visibles.map((entry) => (
      <li><ArticleCard entry={entry} /></li>
    ))}
  </ul>
  {autres.length > 0 && (
    <details class="more-articles">
      <summary>Afficher les {autres.length} autres articles</summary>
      <ul class="cards">
        {autres.map((entry) => (
          <li><ArticleCard entry={entry} /></li>
        ))}
      </ul>
    </details>
  )}

  <section class="liens">
    <h2>Liens</h2>
    <ul class="social">
      <li><a href="https://www.facebook.com/Pixflowave.Coach">Facebook</a></li>
      <li><a href="https://www.instagram.com/pixflowave">Instagram</a></li>
      <li><a href="https://www.linkedin.com/in/pixflowave/">LinkedIn</a></li>
      <li><a href="https://toot.gnous.eu/@Pixflowave" rel="me">Mastodon</a></li>
      <li><a href="https://bsky.app/profile/pixflowave.bsky.social">Bluesky</a></li>
      <li><a href="https://seenthis.net/people/pix_wave">Seenthis</a></li>
      <li><a href="https://github.com/Pixflowave">GitHub</a></li>
    </ul>
  </section>
</Base>