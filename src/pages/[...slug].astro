---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Galerie from '../components/Galerie.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, slugOf, excerpt } from '../lib/articles';

export async function getStaticPaths() {
  const pages = await getCollection('pages', ({ data }) => !data.draft);
  const articles = await getArticles(); // du plus récent au plus ancien

  return [
    ...pages.map((entry) => ({ params: { slug: slugOf(entry) }, props: { entry } })),
    ...articles.map((entry, i) => ({
      params: { slug: slugOf(entry) },
      props: {
        entry,
        newer: articles[i - 1], // article plus récent
        older: articles[i + 1], // article plus ancien
        others: articles.filter((a) => a !== entry),
      },
    })),
  ];
}

const { entry, newer, older, others = [] } = Astro.props;
const { Content } = await render(entry);
const { title, heading, date, tags, coverImage } = entry.data;
const isArticle = entry.collection === 'articles';
const slug = slugOf(entry);
const description = isArticle ? excerpt(entry) : entry.data.description;

// Image de partage (og:image), toujours générée quand une couverture existe
const ogImage = coverImage
  ? (await getImage({ src: coverImage, width: 1200, format: 'jpg' })).src
  : undefined;
// Couverture affichée seulement si le texte ne contient pas déjà d'image (évite les doublons)
const showCover = coverImage && !/!\[[^\]]*\]\(|<img\b/.test(entry.body ?? '');
---

<Base title={title} description={description} image={ogImage}>
  <article class:list={{ 'article-content': isArticle }}>
    <h1>{heading ?? title}</h1>
    {isArticle && date && (
      <p>
        <time datetime={date.toISOString()}>
          {date.toLocaleDateString('fr-FR', { dateStyle: 'long' })}
        </time>
      </p>
    )}
    {showCover && (
      <Image src={coverImage} alt="" widths={[600, 1000, 1400]} sizes="(max-width: 60rem) 100vw, 60rem" class="cover" />
    )}
    {slug === 'image' && <Galerie />}
    <Content />
    {isArticle && tags.length > 0 && (
      <ul class="tags">
        {tags.map((tag) => <li>#{tag}</li>)}
      </ul>
    )}
  </article>

  {isArticle && (
    <nav class="article-nav" aria-label="Articles">
      {(older || newer) && (
        <div class="prev-next">
          {older ? <ArticleCard entry={older} label="← Précédent" compact /> : <span />}
          {newer ? <ArticleCard entry={newer} label="Suivant →" compact /> : <span />}
        </div>
      )}

      {others.length > 0 && (
        <>
          <h2>Autres articles</h2>
          <ul class="strip">
            {others.map((a) => (
              <li><ArticleCard entry={a} /></li>
            ))}
          </ul>
        </>
      )}
    </nav>
  )}
</Base>
